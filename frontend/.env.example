# Copy to .env.local for development. Real values live in Hostinger's environment settings,
# never in the repository. Only NEXT_PUBLIC_* values reach the browser.

# Site
NEXT_PUBLIC_SITE_URL=https://www.iimtechnicalservices.com
# production | staging | development | test  (staging = Basic Auth + noindex)
SITE_ENV=development
# Staging Basic Auth, "user:password" (only read when SITE_ENV=staging)
STAGING_BASIC_AUTH=

# Sanity (leave the project ID empty to run on local fixtures)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
# Viewer token: only needed for draft mode / Presentation (visual editing). Server-side only.
SANITY_API_READ_TOKEN=
# Shared with the Sanity "Revalidate site" webhook
SANITY_REVALIDATE_SECRET=

# Lead delivery (Make or n8n)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Spam protection (Cloudflare Turnstile). Test keys work on localhost:
# site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IIM Technical Services <no-reply@iimtechnicalservices.com>"
OWNER_EMAIL=

# Feature flags
ENABLE_UPLOADS=false
# Content Security Policy: report-only | enforce
CSP_MODE=report-only
# Keep true: Next.js needs inline scripts; the strict policy stops hydration (ADR-003)
CSP_ALLOW_INLINE_SCRIPTS=true

# Analytics (optional, loaded lazily)
NEXT_PUBLIC_GA_ID=
